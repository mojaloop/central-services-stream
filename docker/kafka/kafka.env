ALLOW_PLAINTEXT_LISTENER=yes
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_ADVERTISED_HOST_NAME=kafka
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_CFG_LISTENERS=CONTROLLER://:9093,LISTENER_DOCKER://:29092,LISTENER_EXTERN://:9092
KAFKA_CFG_ADVERTISED_LISTENERS=LISTENER_DOCKER://kafka:29092,LISTENER_EXTERN://localhost:9092
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,LISTENER_DOCKER:PLAINTEXT,LISTENER_EXTERN:PLAINTEXT
KAFKA_CFG_INTER_BROKER_LISTENER_NAME=LISTENER_DOCKER
KAFKA_CFG_LOG_MESSAGE_TIMESTAMP_TYPE=LogAppendTime
KAFKA_CFG_LOG_RETENTION_MS=3600000
KAFKA_CFG_LOG_SEGMENT_BYTES=52428800
KAFKA_CFG_LOG_CLEANUP_POLICY=delete
KAFKA_CFG_COMPRESSION_TYPE=lz4
KAFKA_CFG_NODE_ID=1
KAFKA_CFG_PROCESS_ROLES=broker,controller
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=1@127.0.0.1:9093
KAFKA_ENABLE_KRAFT=true
KAFKA_OPTS=-Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Dcom.sun.management.jmxremote.local.only=false -Dcom.sun.management.jmxremote.port=5555 -Dcom.sun.management.jmxremote.rmi.port=5555 -Djava.rmi.server.hostname=kafka
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g